{
    "headers": [
      {
        "source": "/(.*)",
        "headers": [
          {
            "key": "X-Frame-Options",
            "value": "ALLOWALL"
          },
          {
            "key": "Content-Security-Policy",
            "value": "frame-ancestors 'self' https://bikeeasy.org https://www.bikeeasy.org https://*.bikeeasy.org http://bikeeasy.org http://www.bikeeasy.org"
          },
          {
            "key": "Access-Control-Allow-Origin",
            "value": "https://bikeeasy.org"
          },
          {
            "key": "Access-Control-Allow-Credentials",
            "value": "true"
          }
        ]
      }
    ],
    "crons": [
      {
        "path": "/api/cron/keep-alive",
        "schedule": "0 0 * * *"
      }
    ]
  }